<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sathyakunda.qa</groupId>
    <artifactId>enterprise-quality-automation-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Enterprise Quality Automation Framework</name>
    <description>
        Enterprise Unified Automation Framework for Web, API, Mobile and Performance Testing
    </description>

    <modules>
        <module>core</module>
        <module>web-automation</module>
        <module>api-automation</module>
        <module>mobile-automation</module>
        <module>performance</module>
        <module>test-suite</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <testng.version>7.11.0</testng.version>
        <playwright.version>1.55.0</playwright.version>
        <restassured.version>5.5.6</restassured.version>
        <appium.version>10.0.0</appium.version>
        <assertj.version>3.27.6</assertj.version>
        <jackson.version>2.20.0</jackson.version>
        <slf4j.version>2.0.17</slf4j.version>
        <logback.version>1.5.18</logback.version>
    </properties>

</project>
